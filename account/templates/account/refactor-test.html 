<!-- refactor-test.html -->
{% extends "base.html" %}
{% load static %}

{% block content %}
<div class="refactor-container">

    <!-- Тест новой архитектуры -->
    <div class="refactor-card refactor-card--hover">
        <div class="refactor-card__header">
            <h2 class="refactor-card__title">🎯 Новая архитектура CSS</h2>
            <p class="refactor-card__description">
                Модульная система, построенная с нуля
            </p>
        </div>

        <div class="refactor-card__body">
            <!-- Кнопки -->
            <div class="refactor-flex refactor-gap-4 refactor-items-center" style="flex-wrap: wrap;">
                <button class="refactor-btn refactor-btn--primary">
                    <i class="fas fa-check refactor-btn__icon"></i>
                    Primary Button
                </button>

                <button class="refactor-btn refactor-btn--secondary">
                    Secondary
                </button>

                <button class="refactor-btn refactor-btn--danger refactor-btn--sm">
                    <i class="fas fa-trash refactor-btn__icon"></i>
                    Small Danger
                </button>
            </div>

            <!-- Карточки -->
            <div class="refactor-flex refactor-gap-6" style="margin-top: 2rem; flex-wrap: wrap;">
                <div class="refactor-card refactor-card--hover" style="flex: 1; min-width: 250px;">
                    <div class="refactor-card__body">
                        <h3 class="refactor-card__title">Модульная карточка</h3>
                        <p>Переиспользуемый компонент с consistent стилями</p>
                    </div>
                </div>

                <div class="refactor-card" style="flex: 1; min-width: 250px;">
                    <div class="refactor-card__header">
                        <h3 class="refactor-card__title">С header</h3>
                    </div>
                    <div class="refactor-card__body">
                        <p>Карточка с разделенными секциями</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}